# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Worker that handles authenticated uploads to R2
VITE_R2_WORKER_URL=https://max-images.your-subdomain.workers.dev
# Public URL of the R2 bucket (custom domain or r2.dev)
VITE_R2_PUBLIC_URL=https://images.your-domain.com
